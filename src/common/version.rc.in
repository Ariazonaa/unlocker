// Von CMake je Target konfiguriert (unlocker_version_resource in CMakeLists.txt) - nicht von Hand aendern. Nur ASCII: rc.exe liest ANSI.
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@, @PROJECT_VERSION_MINOR@, @PROJECT_VERSION_PATCH@, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        @RC_FILETYPE@
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "ariazonaa"
            VALUE "FileDescription",  "@RC_DESCRIPTION@"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "@RC_INTERNAL_NAME@"
            VALUE "LegalCopyright",   "(c) 2026 ariazonaa. MIT License."
            VALUE "OriginalFilename", "@RC_ORIGINAL_FILENAME@"
            VALUE "ProductName",      "Unlocker"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
