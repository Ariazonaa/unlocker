<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse Package für das Windows-11-Kontextmenü.
  Enthält nur dieses Manifest; die Binaries liegen im externen Programmordner.
  Bauen/Registrieren: packaging/register-w11-menu.ps1
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">

  <Identity Name="Unlocker.App" Publisher="CN=Unlocker Dev" Version="0.1.2.0" ProcessorArchitecture="x64"/>

  <Properties>
    <DisplayName>Unlocker</DisplayName>
    <PublisherDisplayName>Unlocker</PublisherDisplayName>
    <Logo>Assets\logo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0"/>
  </Dependencies>

  <Resources>
    <Resource Language="de-de"/>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="Unlocker" Executable="unlocker.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements DisplayName="Unlocker" Description="Release locked files and folders"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\logo150.png" Square44x44Logo="Assets\logo44.png"/>
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="UnlockFile" Clsid="CAD0BA06-5865-421D-8C66-5D339B9E8A62"/>
            </desktop5:ItemType>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="UnlockDirectory" Clsid="CAD0BA06-5865-421D-8C66-5D339B9E8A62"/>
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Unlocker context menu">
              <com:Class Id="CAD0BA06-5865-421D-8C66-5D339B9E8A62" Path="unlocker_shell.dll" ThreadingModel="STA"/>
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
    <rescap:Capability Name="unvirtualizedResources"/>
  </Capabilities>
</Package>
